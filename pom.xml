        <calcite.version>1.32.0</calcite.version>
        <elasticsearch.version>8.4.3</elasticsearch.version>
        <common-io.version>2.7</common-io.version>
        <jackson.version>2.10.0</jackson.version>
        <checkstyle.version>2.17</checkstyle.version>
        <common-collection.version>4.3</common-collection.version>
        <mysql-driver.version>8.0.30</mysql-driver.version>
        <common-csv.version>1.8</common-csv.version>
        <junit.version>4.12</junit.version>
