<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>dsp</artifactId>
        <groupId>com.qinyadan.system</groupId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <packaging>pom</packaging>
    <artifactId>dsp-schema</artifactId>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <schema.boundary.skip>false</schema.boundary.skip>
    </properties>

    <modules>
        <module>common-schema</module>
        <module>file-schema</module>
        <module>hive-schema</module>
        <module>mysql-schema</module>
        <module>test-schema</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer.version}</version>
                <executions>
                    <execution>
                        <id>enforce-schema-boundaries</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <skip>${schema.boundary.skip}</skip>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>false</searchTransitive>
                                    <excludes>
                                        <exclude>com.qinyadan.system:file-schema</exclude>
                                        <exclude>com.qinyadan.system:mysql-schema</exclude>
                                        <exclude>com.qinyadan.system:hive-schema</exclude>
                                        <exclude>com.qinyadan.system:dsp-core</exclude>
                                        <exclude>com.qinyadan.system:dsp-engine</exclude>
                                        <exclude>com.qinyadan.system:dsp-protocol</exclude>
                                        <exclude>com.qinyadan.system:dsp-raft</exclude>
                                        <exclude>com.qinyadan.system:dsp-register</exclude>
                                        <exclude>com.qinyadan.system:dsp-storage-api</exclude>
                                        <exclude>com.qinyadan.system:dsp-storage-lucene</exclude>
                                    </excludes>
                                    <message>Schema connectors may depend only on common-schema and external APIs; connector implementations and the main runtime must remain isolated.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
